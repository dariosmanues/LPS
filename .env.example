# WhatsApp Cloud API (Optional)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="lps_verify_token_2026"

# Server-to-server integration from TimbangQR. Use a long random value in Vercel.
TIMBANGQR_INTEGRATION_SECRET="change-this-to-a-long-random-secret"
